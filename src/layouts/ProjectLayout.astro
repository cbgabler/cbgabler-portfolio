---
import BaseLayout from "./BaseLayout.astro";
import TechPill from "../components/TechPill.astro";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { data } = project;
const description = data.tagline.length > 155
  ? data.tagline.slice(0, 152) + "…"
  : data.tagline;
---

<BaseLayout title={data.title} description={description} pageId="project-detail">
  <article class="site-container project-detail">
    <a href="/#projects" class="back-link">
      <Icon name="lucide:arrow-left" class="link-icon" />
      All projects
    </a>

    <header class="project-header">
      <div class="project-meta">
        <span class="project-date">{data.date}</span>
        {data.status && (
          <span class="status-pill">
            <span class="status-dot" aria-hidden="true"></span>
            {data.status}
          </span>
        )}
      </div>

      <h1>{data.title}</h1>
      <p class="project-tagline">{data.tagline}</p>

      {data.awards && (
        <div class="award-strip">
          <Icon name="lucide:award" class="link-icon" />
          <span>{data.awards}</span>
        </div>
      )}

      <div class="project-tech">
        {data.tech.map((tech) => <TechPill label={tech} />)}
      </div>

      {(data.repoUrl || data.liveUrl || data.submissionUrl) && (
        <div class="project-actions">
          {data.repoUrl && (
            <a href={data.repoUrl} target="_blank" rel="noreferrer" class="button-link">
              <Icon name="lucide:github" class="link-icon" />
              Repository
            </a>
          )}
          {data.submissionUrl && (
            <a href={data.submissionUrl} target="_blank" rel="noreferrer" class="button-link">
              <Icon name="lucide:file-text" class="link-icon" />
              {data.submissionLabel ?? "Submission"}
            </a>
          )}
          {data.liveUrl && (
            <a href={data.liveUrl} target="_blank" rel="noreferrer" class="button-link">
              <Icon name="lucide:external-link" class="link-icon" />
              Live demo
            </a>
          )}
        </div>
      )}
    </header>

    <div class="content-rule" aria-hidden="true"></div>
    <div class="prose"><slot /></div>
    <div class="content-rule end-rule" aria-hidden="true"></div>

    <a href="/#projects" class="back-link">
      <Icon name="lucide:arrow-left" class="link-icon" />
      All projects
    </a>
  </article>
</BaseLayout>

<style>
  .project-detail {
    padding-block: clamp(3rem, 7vw, 5.5rem) 6rem;
  }

  .back-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.45rem;
    color: var(--route-active);
    font-family: var(--font-sans);
    font-size: 0.78rem;
  }

  .back-link:hover {
    color: var(--silk);
  }

  .link-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  .project-header {
    max-width: 60rem;
    margin-top: 2rem;
  }

  .project-date {
    color: var(--route-active);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 1rem 0 0;
    color: var(--silk);
    font-family: var(--font-sans);
    font-size: clamp(2.8rem, 8vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .project-tagline {
    max-width: 65ch;
    margin: 1.5rem 0 0;
    color: var(--silk-dim);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
  }

  .award-strip {
    margin-top: 1.25rem;
  }

  .project-tech,
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .project-actions {
    gap: 0.75rem;
  }

  .content-rule {
    width: 100%;
    height: 1px;
    margin-block: 3.25rem;
    background: linear-gradient(90deg, var(--route), transparent 72%);
  }

  .end-rule {
    margin-top: 4rem;
  }
</style>
