---
import { SITE } from "../data/site";
---

<aside class="status-ticker" aria-label="Portfolio legend">
  <div class="ticker-inner">
    <span class="legend-title">Map legend</span>
    {SITE.ticker.map((item, index) => (
      <span class="ticker-item"><span aria-hidden="true">0{index + 1}</span> {item}</span>
    ))}
  </div>
</aside>

<style>
  .status-ticker {
    border-block: 1px solid var(--line-soft);
    background: #080808;
  }

  .ticker-inner {
    display: flex;
    width: min(100% - 2.5rem, 90rem);
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-inline: auto;
    padding-block: 0.7rem;
    color: var(--silk-dim);
    font-family: var(--font-sans);
    font-size: clamp(0.66rem, 1.2vw, 0.78rem);
    letter-spacing: 0.015em;
  }

  .legend-title,
  .ticker-item > span {
    color: #fff;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .legend-title {
    padding-right: 2rem;
    border-right: 1px solid var(--line-soft);
  }

  @media (max-width: 900px) {
    .ticker-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
      padding-block: 0.9rem;
    }
  }

  @media (max-width: 640px) {
    .ticker-inner {
      width: min(100% - 2rem, 90rem);
    }

    .legend-title {
      padding-right: 0;
      border-right: 0;
    }
  }
</style>
