---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import TechPill from "./TechPill.astro";
import TvlaTrace from "./TvlaTrace.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { data, slug } = project;
const caseStudyUrl = `/projects/${slug}/`;
---

<article class:list={["project-card", "panel", { featured }]} data-reveal aria-labelledby={`project-${slug}-title`}>
  {featured && data.hero && (
    <div class="project-visual">
      <Image
        src={data.hero}
        alt={data.heroAlt ?? `${data.title} architecture`}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 1152px) 42rem, 100vw"
        loading="lazy"
        decoding="async"
      />
      <div class="visual-label" aria-hidden="true">project study / architecture</div>
    </div>
  )}

  <div class="project-content">
    <div class="project-topline">
      <span class="project-index">{featured ? "featured work" : "field note"}</span>
      <span class="project-date">{data.date}</span>
    </div>

    {data.awards && (
      <div class="award-strip">
        <Icon name="lucide:award" class="award-icon" />
        <span>{data.awards}</span>
      </div>
    )}

    <h3 id={`project-${slug}-title`}>{data.title}</h3>
    <p class="project-summary">{data.homeSummary ?? data.tagline}</p>

    {slug === "glassbox" && <TvlaTrace />}

    {data.homeStats && data.homeStats.length > 0 && (
      <ul class="project-stats" aria-label={`${data.title} outcomes`}>
        {data.homeStats.map((stat) => <li class="stat-chip">{stat}</li>)}
      </ul>
    )}

    <div class="project-tech" aria-label="Technologies used">
      {data.tech.slice(0, featured ? 8 : 6).map((tech) => <TechPill label={tech} />)}
    </div>

    <div class="project-actions">
      {data.repoUrl && (
        <a href={data.repoUrl} target="_blank" rel="noreferrer" class="button-link">
          <Icon name="lucide:github" class="action-icon" />
          GitHub
        </a>
      )}
      <a href={caseStudyUrl} class="case-study-link">
        Read case study
        <Icon name="lucide:arrow-right" class="action-icon arrow" />
      </a>
    </div>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    overflow: hidden;
  }

  .project-card.featured {
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    min-height: 34rem;
  }

  .project-visual {
    position: relative;
    min-height: 26rem;
    overflow: hidden;
    border-right: 1px solid var(--line-soft);
    background: #020202;
  }

  .project-visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.86;
    filter: saturate(0.72) contrast(1.06);
  }

  .project-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 55%, rgba(0, 0, 0, 0.92));
  }

  .visual-label {
    position: absolute;
    z-index: 1;
    right: 1rem;
    bottom: 1rem;
    color: var(--route-active);
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 3.25rem);
  }

  .project-card:not(.featured) .project-content {
    max-width: 58rem;
  }

  .project-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    color: var(--silk-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .project-index {
    color: var(--route-active);
  }

  .award-strip {
    margin-bottom: 1rem;
  }

  .award-icon,
  .action-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }

  h3 {
    margin: 0;
    color: var(--silk);
    font-family: var(--font-sans);
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.05;
  }

  .project-card:not(.featured) h3 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
  }

  .project-summary {
    max-width: 65ch;
    margin: 1.2rem 0 0;
    color: var(--silk-dim);
    line-height: 1.72;
  }

  .project-stats,
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .project-tech {
    margin-top: 1rem;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.6rem;
  }

  .case-study-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.45rem;
    color: var(--route-active);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .case-study-link .arrow {
    transition: transform 140ms ease;
  }

  .case-study-link:hover {
    color: var(--silk);
  }

  .case-study-link:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 850px) {
    .project-card.featured {
      grid-template-columns: 1fr;
    }

    .project-visual {
      min-height: 18rem;
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
    }
  }

  @media (max-width: 500px) {
    .project-topline {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
