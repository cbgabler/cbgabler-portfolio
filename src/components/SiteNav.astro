---
import { Icon } from "astro-icon/components";
import { NAV_LINKS, SITE } from "../data/site";
---

<header class="site-nav">
  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8 flex items-center justify-between py-4">
    <a href="/" class="brand">
      <span class="brand-name">{SITE.name}</span>
    </a>

    <nav aria-label="Primary" class="hidden sm:block">
      <ul class="flex items-center gap-1">
        {NAV_LINKS.map((l) => (
          <li>
            <a href={l.href} class="nav-link">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="mobile-menu-toggle sm:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <Icon name="lucide:menu" class="menu-icon menu-icon-open" />
      <Icon name="lucide:x" class="menu-icon menu-icon-close" />
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="mobile-menu sm:hidden"
    aria-label="Primary mobile"
    hidden
  >
    <ul>
      {NAV_LINKS.map((l) => (
        <li>
          <a href={l.href} class="mobile-nav-link">{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (btn && menu) {
    const close = () => {
      btn.setAttribute("aria-expanded", "false");
      menu.setAttribute("hidden", "");
      document.body.classList.remove("mobile-menu-open");
    };

    const open = () => {
      btn.setAttribute("aria-expanded", "true");
      menu.removeAttribute("hidden");
      document.body.classList.add("mobile-menu-open");
    };

    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      isOpen ? close() : open();
    });

    menu.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", close);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 12, 14, 0.72);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }

  .site-nav::after {
    content: "";
    position: absolute;
    inset: auto 0 -1px 0;
    height: 1px;
    background: var(--color-border);
    opacity: 0.6;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--color-fg-strong);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.005em;
    padding: 0.15rem 0.1rem;
    transition: color 120ms ease;
  }

  .brand:hover {
    color: var(--color-accent-soft);
  }

  .brand-name {
    color: inherit;
  }

  .nav-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-fg-muted);
    padding: 0.4rem 0.65rem;
    border-radius: 4px;
    transition: color 120ms ease, background-color 120ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-fg-strong);
    background: rgba(255, 255, 255, 0.04);
  }

  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-fg);
    cursor: pointer;
    transition: color 120ms ease, border-color 120ms ease,
      background-color 120ms ease;
  }

  .mobile-menu-toggle:hover,
  .mobile-menu-toggle:focus-visible {
    color: var(--color-accent-soft);
    border-color: var(--color-accent);
    background: rgba(215, 63, 9, 0.06);
  }

  .menu-icon {
    width: 20px;
    height: 20px;
  }

  .menu-icon-close {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded="true"] .menu-icon-open {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded="true"] .menu-icon-close {
    display: inline-block;
  }

  .mobile-menu {
    border-top: 1px solid var(--color-border);
    background: rgba(11, 12, 14, 0.96);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    backdrop-filter: saturate(140%) blur(10px);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0.4rem 0;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.95rem 1.25rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-fg);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: color 120ms ease, background-color 120ms ease;
  }

  .mobile-menu li:last-child .mobile-nav-link {
    border-bottom: none;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    color: var(--color-accent-soft);
    background: rgba(255, 255, 255, 0.03);
  }

  :global(body.mobile-menu-open) {
    overflow: hidden;
  }
</style>
