    </svg>

    <p class="map-note">A conceptual map. Choose a neighborhood to explore.</p>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>(".hero");
  const heroFrame = document.querySelector<HTMLElement>(".poster-frame");
  const districts = document.querySelectorAll<SVGAElement>(".hero .map-district");
  const routes = document.querySelectorAll<SVGPathElement>(".hero [data-route]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (hero && heroFrame && !reduceMotion) {
    let ticking = false;

    const updateHeroProgress = () => {
      const rect = hero.getBoundingClientRect();
      const scrollRange = Math.max(hero.offsetHeight - window.innerHeight, 1);
      const progress = Math.min(Math.max(-rect.top / scrollRange, 0), 1);
      const easedFade = Math.pow(progress, 1.45);
      heroFrame.style.setProperty("--hero-progress", easedFade.toFixed(4));
      heroFrame.style.setProperty("--hero-scale", (1 + easedFade * 0.025).toFixed(4));
      ticking = false;
    };

    const requestHeroUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateHeroProgress);
    };

    updateHeroProgress();
    window.addEventListener("scroll", requestHeroUpdate, { passive: true });
    window.addEventListener("resize", requestHeroUpdate);
  }

  const setActiveRoute = (route: string | null) => {
    routes.forEach((path) => {
      const active = path.dataset.route === route;
      path.classList.toggle("active", active);
      if (active && !reduceMotion) {
        path.classList.remove("traveling");
        path.getBoundingClientRect();
        path.classList.add("traveling");
      } else if (!active) {
        path.classList.remove("traveling");
      }
    });
  };

  districts.forEach((district) => {
    const activate = () => setActiveRoute(district.dataset.mapTarget ?? null);
    district.addEventListener("pointerenter", activate);
    district.addEventListener("focus", activate);
    district.addEventListener("pointerleave", () => {
      if (!district.matches(":focus")) setActiveRoute(null);
    });
    district.addEventListener("blur", () => setActiveRoute(null));
  });
</script>

<style>
  .hero {
    position: relative;
    height: 180svh;
    min-height: 70rem;
    background: #030303;
  }

  .poster-frame {
    --hero-progress: 0;
    --hero-scale: 1;
    position: sticky;
    top: 0;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: #030303;
    opacity: calc(1 - var(--hero-progress));
    transform: scale(var(--hero-scale));
    transform-origin: center;
    will-change: opacity, transform;
  }

  .city-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    color: var(--route);
  }

  .map-ground {
    fill: #050505;
    stroke: none;
  }

  .micro-grid {
    fill: url(#micro-grid);
    color: #fff;
  }

  .map-border path,
  .scale-mark path {
    fill: none;
    stroke: var(--route);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .map-border > path:first-child {
    display: none;
  }

  .map-border text,
  .scale-mark text {
    fill: var(--silk-faint);
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.16em;
  }

  .city-blocks path {
    fill: #090909;
    stroke: rgba(255, 255, 255, 0.2);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .building-mass path {
    fill: #171717;
    stroke: rgba(255, 255, 255, 0.32);
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .minor-streets path,
  .major-roads path,
  .river path,
  .tour-routes path,
  .origin path,
  .origin circle {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .minor-streets path {
    stroke: rgba(255, 255, 255, 0.28);
    stroke-width: 1;
  }

  .major-roads path {
    stroke: #ededE9;
    stroke-width: 3.2;
    filter: url(#soft-shadow);
  }

  .river-bed {
    stroke: #111;
    stroke-width: 58;
  }

  .river-edge {
    stroke: rgba(255, 255, 255, 0.4);
    stroke-width: 1.2;
    stroke-dasharray: 5 7;
  }

  .tour-routes path {
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 2;
    stroke-dasharray: 4 8;
    transition: stroke 160ms ease, stroke-width 160ms ease, opacity 160ms ease;
  }

  .tour-routes path.active {
    stroke: #fff;
    stroke-width: 4;
    opacity: 1;
  }

  .tour-routes path.traveling {
    animation: travel 700ms ease-out 1;
  }

  @keyframes travel {
    from { stroke-dasharray: 2 18; stroke-dashoffset: 42; }
    to { stroke-dasharray: 28 0; stroke-dashoffset: 0; }
  }

  .origin circle,
  .origin path {
    stroke: #fff;
    stroke-width: 1.2;
  }

  .origin circle:last-of-type {
    fill: #fff;
  }

  .origin text {
    fill: #fff;
    font-family: var(--font-sans);
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .map-district {
    cursor: pointer;
    outline: none;
  }

  .district-area {
    fill: transparent;
    stroke: transparent;
    stroke-width: 1.5;
    transition: fill 160ms ease, stroke 160ms ease;
    vector-effect: non-scaling-stroke;
  }

  .district-marker {
    fill: #050505;
    stroke: rgba(255, 255, 255, 0.72);
    stroke-width: 1.5;
    transition: fill 160ms ease, stroke-width 160ms ease;
    vector-effect: non-scaling-stroke;
  }

  .district-index,
  .district-name,
  .district-detail {
    fill: #fff;
    font-family: var(--font-sans);
    pointer-events: none;
  }

  .district-index {
    font-size: 12px;
    font-weight: 600;
  }

  .district-name {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .district-detail {
    fill: var(--silk-faint);
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .map-district:hover .district-area,
  .map-district:focus-visible .district-area {
    fill: rgba(255, 255, 255, 0.055);
    stroke: rgba(255, 255, 255, 0.72);
    stroke-dasharray: 6 7;
  }

  .map-district:hover .district-marker,
  .map-district:focus-visible .district-marker {
    fill: #fff;
    stroke-width: 3;
  }

  .map-district:hover .district-index,
  .map-district:focus-visible .district-index {
    fill: #050505;
  }

  .map-district:focus-visible {
    outline: none;
  }

  .hero-copy {
    position: absolute;
    z-index: 4;
    top: clamp(4rem, 10vw, 8.5rem);
    left: clamp(2rem, 7vw, 7rem);
    width: min(48rem, 58%);
    padding: 1rem 3rem 2.5rem 0;
    background: linear-gradient(90deg, #030303 0%, rgba(3, 3, 3, 0.94) 67%, transparent 100%);
    pointer-events: none;
  }

  .hero-location {
    margin: 0 0 0.85rem;
    color: var(--silk-dim);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    color: #fff;
    font-family: var(--font-sans);
    font-size: clamp(3rem, 7.6vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .hero-subhead {
    max-width: 58ch;
    margin: 1.5rem 0 0;
    color: var(--silk-dim);
    font-size: clamp(0.95rem, 1.35vw, 1.12rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
  }

  .poster-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid #fff;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    pointer-events: auto;
  }

  .poster-link:hover {
    background: #fff;
    color: #050505;
  }

  .map-note {
    position: absolute;
    right: 3rem;
    bottom: 2rem;
    z-index: 3;
    margin: 0;
    color: var(--silk-faint);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 780px) {
    .hero {
      height: 165svh;
      min-height: 58rem;
    }

    .hero-copy {
      top: clamp(2.5rem, 8vw, 5rem);
      left: 1.25rem;
      width: min(36rem, calc(100% - 2.5rem));
      padding: 1rem 1.5rem 2rem 0;
      background: linear-gradient(90deg, #030303 0%, rgba(3, 3, 3, 0.93) 78%, transparent 100%);
    }

    h1 {
      font-size: clamp(3rem, 13vw, 5.2rem);
    }

    .hero-subhead {
      max-width: 48ch;
    }

    .map-note {
      right: 1.25rem;
      bottom: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .hero {
      height: 160svh;
      min-height: 52rem;
    }

    .hero-copy {
      top: 2rem;
      left: 1rem;
      width: calc(100% - 2rem);
      padding: 0.75rem 0 1.5rem;
      background: linear-gradient(180deg, #030303 0%, rgba(3, 3, 3, 0.92) 78%, transparent 100%);
    }

    .district-detail,
    .map-border text,
    .scale-mark {
      display: none;
    }

    .district-name {
      font-size: 15px;
      letter-spacing: 0.08em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: 100svh;
      min-height: 0;
    }

    .poster-frame {
      position: relative;
      opacity: 1;
      transform: none;
    }

    .tour-routes path.traveling {
      animation: none;
    }

    .tour-routes path,
    .district-area,
    .district-marker {
      transition: none;
    }
  }
</style>
