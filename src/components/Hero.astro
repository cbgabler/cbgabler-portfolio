      <a class="map-district" href={byId.experience.href} data-map-target="io" aria-label={byId.experience.description}>
        <path class="district-area" d="M874 312L1150 280 1164 568 910 594 826 450Z" />
        <circle class="district-marker" cx="1002" cy="446" r="27" />
        <text class="district-index" x="1002" y="438" text-anchor="middle">03</text>
        <text class="district-name" x="1002" y="482" text-anchor="middle">TIMELINE</text>
        <text class="district-detail" x="1002" y="501" text-anchor="middle">PLACES & PEOPLE</text>
