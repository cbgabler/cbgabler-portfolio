      <a class="map-district" href={byId.contact.href} data-map-target="pad" aria-label={byId.contact.description}>
        <path class="district-area" d="M96 542L446 520 554 696 426 788 96 766 44 638Z" />
        <circle class="district-marker" cx="344" cy="674" r="27" />
        <text class="district-index" x="344" y="666" text-anchor="middle">05</text>
        <text class="district-name" x="344" y="710" text-anchor="middle">CONTACT</text>
        <text class="district-detail" x="344" y="729" text-anchor="middle">OPEN CHANNEL</text>
