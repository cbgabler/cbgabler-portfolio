---
import { MAP_DISTRICTS, SITE } from "../data/site";

const destinations = MAP_DISTRICTS.filter((district) => district.id !== "core");
const byId = Object.fromEntries(destinations.map((district) => [district.id, district]));
---

<section id="core" class="hero" aria-labelledby="hero-heading">
  <div class="poster-frame">
    <div class="hero-copy">
      <p class="hero-location">{SITE.hero.eyebrow}</p>
      <h1 id="hero-heading">{SITE.hero.heading}</h1>
      <p class="hero-subhead">{SITE.hero.subhead}</p>
      <div class="hero-actions">
        <a href="#projects" class="poster-link">Selected work</a>
        <a href="#contact" class="poster-link">Start a conversation</a>
      </div>
    </div>

    <svg
      class="city-map"
      viewBox="0 0 1200 820"
      preserveAspectRatio="xMidYMid slice"
      role="group"
      aria-labelledby="map-title map-description"
