      <a class="map-district" href={byId["off-duty"].href} data-map-target="dsp" aria-label={byId["off-duty"].description}>
        <path class="district-area" d="M606 550L900 532 1010 770 680 780 570 672Z" />
        <circle class="district-marker" cx="758" cy="654" r="27" />
        <text class="district-index" x="758" y="646" text-anchor="middle">04</text>
        <text class="district-name" x="758" y="690" text-anchor="middle">AFTER DARK</text>
        <text class="district-detail" x="758" y="709" text-anchor="middle">MUSIC & CURIOSITY</text>
