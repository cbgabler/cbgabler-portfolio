---
import { Icon } from "astro-icon/components";
import { SITE } from "../data/site";
---

<section id="contact" class="section-shell contact" aria-labelledby="contact-heading">
  <div class="site-container contact-grid">
    <header class="section-header" data-reveal>
      <p class="section-eyebrow">District 05 · Contact</p>
      <h2 id="contact-heading" class="section-title">Let's talk</h2>
      <p class="availability">{SITE.availability}</p>
    </header>

    <div class="contact-panel panel" data-reveal>
      <div class="email-row">
        <div>
          <span class="contact-label">email</span>
          <a class="contact-primary" href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>
        </div>
        <button class="copy-button" type="button" data-email={SITE.contact.email} aria-describedby="copy-status">
          <Icon name="lucide:copy" class="contact-icon" />
          <span>Copy</span>
        </button>
      </div>

      <div class="contact-links">
        <a href={SITE.contact.github.url} target="_blank" rel="noreferrer">
          <Icon name="lucide:github" class="contact-icon" />
          GitHub
        </a>
        <a href={SITE.contact.linkedin.url} target="_blank" rel="noreferrer">
          <Icon name="lucide:linkedin" class="contact-icon" />
          LinkedIn
        </a>
      </div>

      <p id="copy-status" class="copy-status" aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>(".copy-button");
  const copyStatus = document.getElementById("copy-status");

  copyButton?.addEventListener("click", async () => {
    const email = copyButton.dataset.email;
    if (!email || !copyStatus) return;

    try {
      if (!navigator.clipboard) throw new Error("Clipboard unavailable");
      await navigator.clipboard.writeText(email);
      copyButton.querySelector("span")!.textContent = "Copied";
      copyStatus.textContent = "Email address copied to clipboard.";
      window.setTimeout(() => {
        copyButton.querySelector("span")!.textContent = "Copy";
      }, 2200);
    } catch {
      copyStatus.textContent = "Copy failed. Select the email address and copy it manually.";
    }
  });
</script>

<style>
  .contact {
    background: var(--bg-deep);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(24rem, 1.25fr);
    gap: clamp(2.5rem, 8vw, 7rem);
    align-items: end;
  }

  .section-header {
    margin-bottom: 0;
  }

  .availability {
    max-width: 38ch;
    margin: 1.25rem 0 0;
    color: var(--silk-dim);
  }

  .contact-panel {
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .email-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .email-row > div {
    min-width: 0;
  }

  .contact-label {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--silk-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-primary {
    color: var(--route-active);
    font-family: var(--font-mono);
    font-size: clamp(0.92rem, 2.5vw, 1.25rem);
    overflow-wrap: anywhere;
  }

  .contact-primary:hover {
    color: var(--silk);
  }

  .copy-button,
  .contact-links a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border: 1px solid var(--route);
    background: transparent;
    color: var(--route-active);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    cursor: pointer;
    transition: border-color 140ms ease, background-color 140ms ease,
      color 140ms ease;
  }

  .copy-button {
    flex: 0 0 auto;
    padding: 0.55rem 0.8rem;
  }

  .copy-button:hover,
  .contact-links a:hover {
    border-color: var(--route-active);
    background: #fff;
    color: #050505;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .contact-links a {
    padding: 0.55rem 0.85rem;
  }

  .contact-icon {
    width: 1rem;
    height: 1rem;
  }

  .copy-status {
    min-height: 1.4em;
    margin: 0.8rem 0 0;
    color: var(--silk-dim);
    font-size: 0.75rem;
  }

  @media (max-width: 800px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 500px) {
    .email-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
