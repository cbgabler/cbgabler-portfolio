---
import { SITE } from "../data/site";
---

<section id="about" class="py-16 sm:py-20" aria-labelledby="about-heading">
  <div class="max-w-3xl">
    <header class="mb-6">
      <h2
        id="about-heading"
        class="font-display text-3xl sm:text-4xl font-semibold text-[var(--color-fg-strong)]"
      >
        About
      </h2>
    </header>

    <div class="prose">
      {SITE.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
