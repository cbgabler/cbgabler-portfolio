---
import { SITE } from "../data/site";
---

<section id="about" class="py-12 sm:py-16" aria-labelledby="about-heading">
  <header class="mb-6">
    <h2
      id="about-heading"
      class="font-display text-2xl sm:text-3xl font-semibold text-[var(--color-fg-strong)]"
    >
      About
    </h2>
  </header>

  <div class="prose">
    {SITE.about.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
