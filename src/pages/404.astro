---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" pageId="not-found">
  <section class="py-24 text-center">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-fg-muted)] mb-3">
      404
    </p>
    <h1 class="font-display text-4xl sm:text-5xl font-semibold text-[var(--color-fg-strong)] mb-4">
      Page not found
    </h1>
    <p class="text-[var(--color-fg-muted)] max-w-[50ch] mx-auto mb-8">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-4 py-2 border border-[var(--color-accent)] bg-[var(--color-accent)] text-[var(--color-bg)] rounded-md text-sm font-semibold hover:bg-[var(--color-accent-soft)] hover:border-[var(--color-accent-soft)] transition-colors"
    >
      Back home
    </a>
  </section>
</BaseLayout>
