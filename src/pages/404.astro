---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" pageId="not-found">
  <section class="site-container not-found">
    <p class="section-eyebrow">// 404</p>
    <h1>Signal lost.</h1>
    <p>The page you're looking for doesn't exist or has moved out of range.</p>
    <a href="/" class="button-link">Back home</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: calc(100dvh - var(--nav-height));
    place-content: center;
    justify-items: start;
    padding-block: 5rem;
  }

  h1 {
    margin: 0;
    color: var(--silk);
    font-family: var(--font-mono);
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .not-found > p:not(.section-eyebrow) {
    max-width: 48ch;
    margin: 1.25rem 0 2rem;
    color: var(--silk-dim);
  }
</style>
